# Neon Postgres connection string (get it from the Neon dashboard)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/moodlystate?sslmode=require"

PORT=3000

# Public base URL used to build the shareable state URL: {BASE_URL}/{username}/{code}
BASE_URL="http://localhost:5173"

# Origin(s) allowed to call the API with credentials (comma-separated)
CORS_ORIGIN="http://localhost:5173"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

COOKIE_NAME="moodly_session"
COOKIE_SECURE=false
