generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TokenPurpose {
  SET_PASSWORD
  RESET_PASSWORD
}

model User {
  id           String      @id @default(uuid())
  // Null until the user completes the emailed set-password step, where the
  // username is chosen alongside the password.
  username     String?     @unique
  email        String      @unique
  passwordHash String?
  createdAt    DateTime    @default(now())
  states       MoodState[]
  statesAbout  MoodState[] @relation("StatesAbout")
  authTokens   AuthToken[]

  relationshipStatusesSet     RelationshipStatus[] @relation("RelationshipStatusSetByMe")
  relationshipStatusesAboutMe RelationshipStatus[] @relation("RelationshipStatusSetAboutMe")
}

model AuthToken {
  id        String       @id @default(uuid())
  // sha256 of the raw token; the raw token only ever exists in the emailed link
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MoodState {
  id           String   @id @default(uuid())
  code         String
  categoryId   Int?
  categoryName String
  createdAt    DateTime @default(now())
  // Flips to true the first time the recipient opens the public link — lets
  // the sender's list distinguish "sent" from "read" (leído) for this kanjo.
  checked      Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Who the state is about (e.g. a relationship this feeling concerns).
  // Optional and independent from the owner — the state stays visible to
  // the owner even if the referenced user is later deleted.
  aboutUserId String?
  aboutUser   User?   @relation("StatesAbout", fields: [aboutUserId], references: [id], onDelete: SetNull)

  // A code only needs to be unique per user: the public URL is
  // {BASE_URL}/{username}/{code}, so the (username, code) pair is what
  // must resolve unambiguously — different users may share a code.
  @@unique([userId, code])
  @@index([userId])
  @@index([aboutUserId])
}

// How one user currently sees their relationship with a contact (e.g.
// "couple", "amitié") — unlike MoodState this isn't a history of things
// sent, just the latest value, so a new one replaces the previous (upsert).
// Each side sets their own independently; both sides can see both values,
// but setting one never requires or implies the other side agreeing.
model RelationshipStatus {
  id        String   @id @default(uuid())
  statusId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation("RelationshipStatusSetByMe", fields: [userId], references: [id], onDelete: Cascade)

  aboutUserId String
  aboutUser   User   @relation("RelationshipStatusSetAboutMe", fields: [aboutUserId], references: [id], onDelete: Cascade)

  @@unique([userId, aboutUserId])
  @@index([userId])
  @@index([aboutUserId])
}

// A state shared anonymously, with no logged-in user behind it: the code
// is the only handle on it, so it must be globally unique (unlike
// MoodState.code, which only needs to be unique per owning user).
model SharedState {
  id           String   @id @default(uuid())
  code         String   @unique
  categoryId   Int?
  categoryName String
  createdAt    DateTime @default(now())
}
