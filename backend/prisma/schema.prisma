generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TokenPurpose {
  SET_PASSWORD
  RESET_PASSWORD
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  email        String      @unique
  passwordHash String?
  createdAt    DateTime    @default(now())
  states       MoodState[]
  statesAbout  MoodState[] @relation("StatesAbout")
  authTokens   AuthToken[]
}

model AuthToken {
  id        String       @id @default(uuid())
  // sha256 of the raw token; the raw token only ever exists in the emailed link
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MoodState {
  id           String   @id @default(uuid())
  code         String
  categoryId   Int?
  categoryName String
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Who the state is about (e.g. a relationship this feeling concerns).
  // Optional and independent from the owner — the state stays visible to
  // the owner even if the referenced user is later deleted.
  aboutUserId String?
  aboutUser   User?   @relation("StatesAbout", fields: [aboutUserId], references: [id], onDelete: SetNull)

  // A code only needs to be unique per user: the public URL is
  // {BASE_URL}/{username}/{code}, so the (username, code) pair is what
  // must resolve unambiguously — different users may share a code.
  @@unique([userId, code])
  // A given creator can only have one state about any particular person
  // at a time (NULLs are exempt: Postgres treats each NULL as distinct,
  // so states with no aboutUser never collide here).
  @@unique([userId, aboutUserId])
  @@index([userId])
  @@index([aboutUserId])
}

// A state shared anonymously, with no logged-in user behind it: the code
// is the only handle on it, so it must be globally unique (unlike
// MoodState.code, which only needs to be unique per owning user).
model SharedState {
  id           String   @id @default(uuid())
  code         String   @unique
  categoryId   Int?
  categoryName String
  createdAt    DateTime @default(now())
}
